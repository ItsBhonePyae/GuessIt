<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.guessit.actualapp.controller.RegisterController"
      alignment="CENTER" spacing="16"
      styleClass="root" stylesheets="@../css/theme.css">
    <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>
    <Label text="Create Account" styleClass="title"/>
    <TextField fx:id="usernameField" promptText="Username" styleClass="field"/>
    <TextField fx:id="emailField" promptText="Email" styleClass="field"/>
    <PasswordField fx:id="passwordField" promptText="Password" styleClass="field"/>
    <Button text="Register" onAction="#handleRegister" styleClass="primary-btn" prefWidth="240"/>
    <Label fx:id="statusLabel" styleClass="status"/>
    <Hyperlink text="Back to login" onAction="#goLogin" styleClass="link"/>
</VBox>

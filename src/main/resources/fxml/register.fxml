<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="650.0" prefWidth="1100.0" styleClass="dark-background" stylesheets="@../css/style.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.guessit.login.RegisterController">

   <children>

      <!-- Register form panel -->
      <VBox alignment="CENTER" maxWidth="420.0" spacing="14.0" styleClass="login-form"
            AnchorPane.bottomAnchor="40.0" AnchorPane.leftAnchor="340.0"
            AnchorPane.rightAnchor="340.0" AnchorPane.topAnchor="40.0">
         <padding>
            <Insets bottom="25.0" left="35.0" right="35.0" top="25.0" />
         </padding>

         <children>

            <!-- Title -->
            <VBox alignment="CENTER" spacing="6.0">
               <children>
                  <Label styleClass="title" text="Create Account" />
                  <Label styleClass="subtitle" text="Join Guess It and start guessing" />
               </children>
            </VBox>

            <!-- Status message (success / validation errors) -->
            <Label fx:id="statusLabel" styleClass="status-label" visible="false"
                   managed="false" wrapText="true" />

            <!-- Full name -->
            <TextField fx:id="fullNameField" maxWidth="Infinity" prefHeight="46.0"
                       promptText="Full Name" styleClass="input-field" />

            <!-- Email -->
            <TextField fx:id="emailField" maxWidth="Infinity" prefHeight="46.0"
                       promptText="Email" styleClass="input-field" />

            <!-- Username -->
            <TextField fx:id="usernameField" maxWidth="Infinity" prefHeight="46.0"
                       promptText="Username" styleClass="input-field" />

            <!-- Password -->
            <PasswordField fx:id="passwordField" maxWidth="Infinity" prefHeight="46.0"
                           promptText="Password" styleClass="input-field" />

            <!-- Confirm password -->
            <PasswordField fx:id="confirmPasswordField" maxWidth="Infinity" prefHeight="46.0"
                           promptText="Confirm Password" styleClass="input-field" />

            <!-- Register button -->
            <Button fx:id="registerButton" maxWidth="Infinity" onAction="#handleRegister"
                    prefHeight="52.0" styleClass="login-button" text="Register" />

            <!-- Switch back to Login -->
            <HBox alignment="CENTER" spacing="5.0">
               <children>
                  <Label styleClass="bottom-text" text="Already have an account?" />
                  <Hyperlink onAction="#goToLogin" styleClass="link-text" text="Login" />
               </children>
            </HBox>

         </children>
      </VBox>

   </children>
</AnchorPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootPane" prefHeight="700.0" prefWidth="1100.0"
           styleClass="app-root" stylesheets="@../css/style.css"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.guessit.login.LoginController">

   <children>

      <!-- Background: always fills the window (bound to the root size) -->
      <ImageView fitHeight="${rootPane.height}" fitWidth="${rootPane.width}"
                 preserveRatio="false" pickOnBounds="true">
         <image>
            <Image url="@../images/guessit-background.png" />
         </image>
      </ImageView>

      <!-- Dark overlay so the form stays readable over the image -->
      <Pane styleClass="image-overlay" />

      <!-- Login form panel, pinned to the right -->
      <VBox alignment="CENTER" maxWidth="400.0" spacing="18.0" styleClass="login-form"
            StackPane.alignment="CENTER_RIGHT">
         <StackPane.margin>
            <Insets bottom="40.0" left="20.0" right="60.0" top="40.0" />
         </StackPane.margin>

         <children>

            <!-- Title -->
            <VBox alignment="CENTER" spacing="6.0">
               <children>
                  <Label styleClass="title" text="Welcome Back!" />
                  <Label styleClass="subtitle" text="Login to continue" />
               </children>
            </VBox>

            <!-- Error message (hidden until a login problem occurs) -->
            <Label fx:id="errorLabel" maxWidth="Infinity" managed="false" visible="false"
                   styleClass="error-label" wrapText="true" />

            <!-- Username -->
            <TextField fx:id="usernameField" maxWidth="Infinity" prefHeight="52.0"
                       promptText="Enter Username" styleClass="input-field" />

            <!-- Password -->
            <PasswordField fx:id="passwordField" maxWidth="Infinity" prefHeight="52.0"
                           promptText="Enter Password" styleClass="input-field" />

            <!-- Remember me / forgot password -->
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <CheckBox styleClass="remember-check" text="Remember Me" />
                  <Pane HBox.hgrow="ALWAYS" />
                  <Hyperlink onAction="#handleForgotPassword" styleClass="link-text"
                             text="Forgot Password?" />
               </children>
            </HBox>

            <!-- Login button -->
            <Button fx:id="loginButton" maxWidth="Infinity" onAction="#handleLogin"
                    prefHeight="55.0" styleClass="login-button" text="Login" />

            <!-- Switch to Register -->
            <HBox alignment="CENTER" spacing="5.0">
               <children>
                  <Label styleClass="bottom-text" text="Don't have an account?" />
                  <Hyperlink onAction="#goToRegister" styleClass="link-text" text="Register" />
               </children>
            </HBox>

         </children>
      </VBox>

   </children>
</StackPane>

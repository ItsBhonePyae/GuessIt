<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="700.0" prefWidth="1100.0"
           styleClass="app-root" stylesheets="@../css/style.css"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.guessit.controller.DashboardController">

   <children>

      <!-- Dashboard card -->
      <VBox alignment="CENTER" maxWidth="520.0" spacing="22.0" styleClass="dashboard-card">
         <StackPane.margin>
            <Insets bottom="40.0" left="20.0" right="20.0" top="40.0" />
         </StackPane.margin>

         <children>

            <!-- Welcome heading — name filled in by DashboardController -->
            <Label fx:id="welcomeLabel" styleClass="title" text="Welcome!" />

            <Label styleClass="subtitle" text="You are logged in. Ready to guess some movies?" />

            <!-- Logout -->
            <Button fx:id="logoutButton" maxWidth="220.0" minWidth="180.0" onAction="#handleLogout"
                    prefHeight="52.0" styleClass="logout-button" text="Logout" />

         </children>
      </VBox>

   </children>
</StackPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="800" prefWidth="1200" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1">

    <center>
        <StackPane alignment="CENTER">

            <VBox alignment="CENTER" maxHeight="720" maxWidth="1000" prefHeight="720" prefWidth="1000" spacing="25">

                <padding>
                    <Insets bottom="40" left="60" right="60" top="40" />
                </padding>

                <!-- Email Icon -->

                <StackPane minHeight="120" minWidth="120" prefHeight="120" prefWidth="120">

                    <Circle fill="#f2eeee" radius="60" stroke="GRAY" strokeWidth="2" />

                    <Label style="-fx-font-size: 40px;" text="✉" />

                    <Circle fill="RED" radius="9" translateX="-25" translateY="25" StackPane.alignment="TOP_RIGHT" />

                </StackPane>

                <!-- Title -->

                <Label style="-fx-font-size: 36px;" text="Check your inbox" />

                <!-- Description -->

                <VBox alignment="CENTER" spacing="10">

                    <Label style="-fx-font-size: 22px;" text="Enter the 4-digit code we sent" />

                    <HBox alignment="CENTER" spacing="10">

                        <Label text="to" />

                        <Label text="al••••a@example.com" />

                    </HBox>

                </VBox>

                <Region prefHeight="30" />

                <!-- OTP Input -->

                <HBox alignment="CENTER" spacing="18">

                    <TextField fx:id="otp1" alignment="CENTER" prefHeight="130" prefWidth="130" />

                    <TextField fx:id="otp2" alignment="CENTER" prefHeight="130" prefWidth="130" />

                    <TextField fx:id="otp3" alignment="CENTER" prefHeight="130" prefWidth="130" />

                    <TextField fx:id="otp4" alignment="CENTER" prefHeight="130" prefWidth="130" />

                    <TextField fx:id="otp5" alignment="CENTER" prefHeight="130" prefWidth="130" />

                    <TextField fx:id="otp6" alignment="CENTER" prefHeight="130" prefWidth="130" />

                </HBox>

                <Region prefHeight="20" />

                <!-- Verify Button -->

                <Button fx:id="verifyButton" maxWidth="Infinity" prefHeight="80" text="Verify code" />

                <!-- Resend Code -->

                <HBox alignment="CENTER" spacing="10">

                    <Label text="Didn't get a code?" />

                    <Label fx:id="countdownLabel" text="Resend in 0:25" />

                </HBox>

                <Hyperlink fx:id="resendLink" managed="false" text="Resend code" visible="false" />

            </VBox>

        </StackPane>
    </center>

</BorderPane>

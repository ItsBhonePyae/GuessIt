<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootPane"
           prefHeight="720.0" prefWidth="1200.0"
           styleClass="app-root" stylesheets="@css/guessit.css"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="application.GuessItController">

   <children>

      <!-- Cinema theater background: always fills the window -->
      <ImageView fitHeight="${rootPane.height}" fitWidth="${rootPane.width}"
                 preserveRatio="false" pickOnBounds="true">
         <image>
            <Image url="@../../images/lgbg.gi.png" />
         </image>
      </ImageView>

      <!-- Dark vignette overlay -->
      <Pane styleClass="image-overlay" />

      <!-- Soft gold spotlight -->
      <Pane styleClass="gold-spotlight" />

      <!-- Main content -->
      <VBox fx:id="mainContent" alignment="CENTER" spacing="25.0"
            StackPane.alignment="CENTER">
         <StackPane.margin>
            <Insets bottom="40.0" left="20.0" right="20.0" top="40.0" />
         </StackPane.margin>

         <children>

            <Label text="WELCOME TO" styleClass="welcome-text" />

            <Label text="GUESS THE MOMENT" styleClass="subtitle" />

            <Region prefHeight="20.0" />

            <Button fx:id="loginButton" text="LOGIN"
                    onAction="#handleLogin" styleClass="main-button"
                    prefWidth="220.0" prefHeight="52.0" />

            <Button fx:id="registerButton" text="REGISTER"
                    onAction="#handleRegister" styleClass="main-button"
                    prefWidth="220.0" prefHeight="52.0" />

         </children>
      </VBox>

      <!-- GuessIt wordmark over the theater image's old logo spot -->
      <Label styleClass="brand-watermark" text="GuessIt"
             StackPane.alignment="BOTTOM_CENTER">
         <StackPane.margin>
            <Insets bottom="28.0" />
         </StackPane.margin>
      </Label>

   </children>
</StackPane>

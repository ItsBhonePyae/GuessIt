<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.shape.*?>

<StackPane fx:id="rootPane"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="application.GuessItController"
           stylesheets="@css/guessit.css">

   <!-- Background -->
   <ImageView fx:id="backgroundImage"
              preserveRatio="false"
              fitWidth="1200"
              fitHeight="750"/>

   <!-- Dark Overlay -->
   <Rectangle fill="#00000055"
              width="1200"
              height="750"/>

   <!-- Animation Layer -->
   <Pane fx:id="particlePane"
         mouseTransparent="true"/>

   <!-- Main Content -->
   <VBox fx:id="mainContent"
         alignment="CENTER"
         spacing="25">

      <Label text="WELCOME TO"
             styleClass="welcome-text"/>

      <Label text="GUESS THE MOMENT"
             styleClass="subtitle"/>

      <Region prefHeight="20"/>

      <Button fx:id="loginButton"
              text="LOGIN"
              onAction="#handleLogin"
              styleClass="main-button"/>

      <Button fx:id="registerButton"
              text="REGISTER"
              onAction="#handleRegister"
              styleClass="main-button"/>

   </VBox>

</StackPane>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootPane" prefHeight="720.0" prefWidth="1200.0"
           styleClass="app-root" stylesheets="@../../css/GuessItAuth.css"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.guessit.guessitauth.GuessItRegisterController">

   <children>

      <!-- Cinema theater background: always fills the window -->
      <ImageView fitHeight="${rootPane.height}" fitWidth="${rootPane.width}"
                 preserveRatio="false" pickOnBounds="true">
         <image>
            <Image url="@../../images/lgbg.gi.png" />
         </image>
      </ImageView>

      <!-- Dark vignette -->
      <Pane fx:id="overlayPane" styleClass="image-overlay" />

      <!-- Soft gold spotlight for a premium cinematic feel -->
      <Pane styleClass="gold-spotlight" />

      <!-- GuessIt wordmark over the theater image's old logo spot -->
      <Label styleClass="brand-watermark" text="GuessIt"
             StackPane.alignment="BOTTOM_CENTER">
         <StackPane.margin>
            <Insets bottom="28.0" />
         </StackPane.margin>
      </Label>

      <!-- Glassmorphism card -->
      <VBox fx:id="authCard" alignment="CENTER" maxWidth="440.0" spacing="14.0"
            styleClass="glass-card" StackPane.alignment="CENTER">
         <StackPane.margin>
            <Insets bottom="30.0" left="20.0" right="20.0" top="30.0" />
         </StackPane.margin>

         <children>

            <!-- Brand -->
            <VBox alignment="CENTER" spacing="4.0">
               <children>
                  <Label styleClass="brand-title" text="GuessIt" />
                  <Label styleClass="brand-subtitle" text="Create your account" />
               </children>
            </VBox>

            <!-- Status / validation message -->
            <Label fx:id="statusLabel" managed="false" maxWidth="Infinity" visible="false"
                   styleClass="status-label" wrapText="true" />

            <!-- Full name -->
            <TextField fx:id="fullNameField" maxWidth="Infinity" prefHeight="46.0"
                       promptText="Full Name" styleClass="input-field" />

            <!-- Email -->
            <TextField fx:id="emailField" maxWidth="Infinity" prefHeight="46.0"
                       promptText="Email" styleClass="input-field" />

            <!-- Username -->
            <TextField fx:id="usernameField" maxWidth="Infinity" prefHeight="46.0"
                       promptText="Username" styleClass="input-field" />

            <!-- Password -->
            <PasswordField fx:id="passwordField" maxWidth="Infinity" prefHeight="46.0"
                           promptText="Password" styleClass="input-field" />

            <!-- Confirm password -->
            <PasswordField fx:id="confirmPasswordField" maxWidth="Infinity" prefHeight="46.0"
                           promptText="Confirm Password" styleClass="input-field" />

            <!-- Register button -->
            <Button fx:id="registerButton" maxWidth="Infinity" onAction="#handleRegister"
                    prefHeight="52.0" styleClass="gold-button" text="Register" />

            <!-- Switch back to Login -->
            <HBox alignment="CENTER" spacing="5.0">
               <children>
                  <Label styleClass="bottom-text" text="Already have an account?" />
                  <Hyperlink onAction="#goToLogin" styleClass="link-text" text="Login" />
               </children>
            </HBox>

         </children>
      </VBox>

   </children>
</StackPane>

                    <HBox fx:id="brand" alignment="CENTER_LEFT" spacing="11.0" styleClass="brand">
                        <StackPane minHeight="40.0" minWidth="40.0" maxHeight="40.0" maxWidth="40.0"
                                   styleClass="brand-mark">
                            <Label text="&#9636;" styleClass="brand-glyph"/>

                            <Label text="MOVIE QUIZ" styleClass="brand-sub"/>
                        </VBox>
                    </HBox>

                    <VBox fx:id="navList" spacing="6.0" styleClass="nav">
                        <Button fx:id="navSingleplayer" maxWidth="Infinity"
                                styleClass="nav-item">
                            <graphic>
                                <HBox alignment="CENTER_LEFT" spacing="13.0" styleClass="nav-row">
                                    <Label text="&#9654;" styleClass="nav-glyph"/>
                                    <Label fx:id="navSingleplayerLabel" text="Singleplayer"
                                           styleClass="nav-label"/>
                                </HBox>
                            </graphic>
                        </Button>
                        <Button fx:id="navHistory" maxWidth="Infinity"
                                styleClass="nav-item">
                            <graphic>
                                <HBox alignment="CENTER_LEFT" spacing="13.0" styleClass="nav-row">
                                    <Label text="&#9719;" styleClass="nav-glyph"/>
                                    <Label fx:id="navHistoryLabel" text="History"
                                           styleClass="nav-label"/>
                                </HBox>
                            </graphic>
                        </Button>
                        <!-- Settings deliberately not here; use the gear in the header. -->
                    </VBox>

                    <Region VBox.vgrow="ALWAYS"/>

                    <VBox fx:id="promoCard" spacing="3.0" styleClass="promo-card">
                        <Label text="DAILY STREAK" styleClass="promo-kicker"/>
                        <Label fx:id="streakValue" text="6 days strong" styleClass="promo-value"/>

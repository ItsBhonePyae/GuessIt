<?xml version="1.0" encoding="UTF-8"?>

<!--
    GuessIt - sidebar test, MVC view.

    Model:      SidebarTestModel
    Controller: SidebarTestController (injected explicitly, so Scene Builder
                can open this file without project classes on its classpath)
    Styles:     SidebarTest.css (relative to this file)

    Settings is a header icon beside the bell and opens the settingsOverlay
    modal instead of replacing the centre page.
-->

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="shell" prefHeight="860.0" prefWidth="1320.0"

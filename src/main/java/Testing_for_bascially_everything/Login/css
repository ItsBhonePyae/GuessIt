/* Login Form */
.login-form {
    -fx-background-color: rgba(20, 20, 20, 0.95);
    -fx-background-radius: 20;
    -fx-padding: 35;
    -fx-effect: dropshadow(gaussian, #7E3BED, 20, 0.3, 0, 0);
}

/* Title */
.title {
    -fx-font-size: 32px;
    -fx-font-weight: bold;
    -fx-text-fill: #C6FF34;
}

/* Subtitle */
.subtitle {
    -fx-font-size: 15px;
    -fx-text-fill: white;
}

/* Input */
.input-field {
    -fx-background-color: #252525;
    -fx-text-fill: white;
    -fx-prompt-text-fill: #999999;
    -fx-background-radius: 10;
    -fx-border-color: #7E3BED;
    -fx-border-radius: 10;
}

/* Login Button */
.login-button {
    -fx-background-color: #C6FF34;
    -fx-text-fill: black;
    -fx-font-size: 17px;
    -fx-font-weight: bold;
    -fx-background-radius: 12;
    -fx-cursor: hand;
}

.login-button:hover {
    -fx-background-color: #7E3BED;
    -fx-text-fill: white;
}

/* Hyperlink */
.link-text {
    -fx-text-fill: #C6FF34;
}
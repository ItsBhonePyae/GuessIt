<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="780.0" prefWidth="1220.0" style="-fx-background-color: #EEF2F8; -fx-font-family: 'Segoe UI', 'Inter', Arial, sans-serif;" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1">



    <!-- MAIN CONTENT AREA -->
    <center>
        <VBox spacing="18.0">
            <padding>
                <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
            </padding>

            <!-- Top Search Bar -->
            <HBox alignment="CENTER_LEFT">
                <TextField prefWidth="260.0" promptText="Search...." style="-fx-background-color: #FFFFFF; -fx-background-radius: 20; -fx-border-color: #E2E8F0; -fx-border-radius: 20; -fx-padding: 8 16; -fx-font-size: 12px;" />
                <Region HBox.hgrow="ALWAYS" />
            </HBox>

            <!-- Main White Dashboard Panel -->
            <VBox spacing="18.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 20; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.05), 18, 0, 0, 6);" VBox.vgrow="ALWAYS">

                <!-- Page Title -->
                <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Users" />

                <!-- Summary Stat Cards + Add User Card -->
                <HBox spacing="16.0">
                    <!-- Total Users -->
                    <VBox spacing="10.0" style="-fx-background-color: #F8FAFC; -fx-background-radius: 14; -fx-border-color: #EEF2F6; -fx-border-radius: 14; -fx-padding: 16;" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT">
                            <Label style="-fx-background-color: #2B59C3; -fx-text-fill: white; -fx-padding: 7 9; -fx-background-radius: 8; -fx-font-size: 13px;" text="👤" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Circle fill="#2B59C3" radius="5.0" />
                        </HBox>
                        <VBox spacing="2.0">
                            <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="1" />
                            <Label style="-fx-font-size: 11px; -fx-text-fill: #64748B;" text="Total Players" />
                        </VBox>
                    </VBox>

                    <!-- Admins -->
                    <VBox spacing="10.0" style="-fx-background-color: #F8FAFC; -fx-background-radius: 14; -fx-border-color: #EEF2F6; -fx-border-radius: 14; -fx-padding: 16;" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT">
                            <Label style="-fx-background-color: #2B59C3; -fx-text-fill: white; -fx-padding: 7 9; -fx-background-radius: 8; -fx-font-size: 13px;" text="🛡" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Circle fill="#CBD5E1" radius="5.0" />
                        </HBox>
                        <VBox spacing="2.0">
                            <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="1" />
                            <Label style="-fx-font-size: 11px; -fx-text-fill: #64748B;" text="Admins" />
                        </VBox>
                    </VBox>

                   
                    <!-- Add User Card -->
                    <VBox alignment="CENTER" prefWidth="150.0" spacing="8.0" style="-fx-background-color: #E2E8F0; -fx-background-radius: 14; -fx-padding: 16;">
                        <Label style="-fx-background-color: #CBD5E1; -fx-text-fill: #FFFFFF; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 4 10; -fx-background-radius: 6;" text="+" />
                        <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #334155;" text="Add User" />
                    </VBox>
                </HBox>

                <!-- Filter Row -->
                <HBox alignment="BOTTOM_LEFT" spacing="60.0">
               <children>
                  <Button mnemonicParsing="false" prefHeight="29.0" prefWidth="99.0" text="Active">
                     <HBox.margin>
                        <Insets />
                     </HBox.margin>
                  </Button>
                  <Button mnemonicParsing="false" prefHeight="29.0" prefWidth="99.0" text="Inactive " />
                  <Button mnemonicParsing="false" prefHeight="29.0" prefWidth="99.0" text="Suspend" />
                  <Region prefHeight="29.0" prefWidth="547.0" />
                  <Button mnemonicParsing="false" prefHeight="29.0" prefWidth="99.0" text="Filter" />
               </children>
                </HBox>

                <!-- Users Table -->
                <TableView style="-fx-background-color: transparent; -fx-table-cell-border-color: transparent; -fx-selection-bar: #EEF4FF; -fx-selection-bar-non-focused: #EEF4FF;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn prefWidth="190.0" text="UserName" />
                  <TableColumn prefWidth="75.0" text="FullName" />
                        <TableColumn prefWidth="230.0" text="E-mail" />
                        <TableColumn prefWidth="150.0" text="Role" />
                        <TableColumn prefWidth="80.0" text="User_Status" />
                        <TableColumn prefWidth="165.0" text="Last_Login" />
                        <TableColumn prefWidth="90.0" text="Created_at" />
                  <TableColumn prefWidth="75.0" text="Updated_at" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <!-- Pagination Bar -->
                <HBox alignment="CENTER" spacing="8.0">
                    <Button mnemonicParsing="false" style="-fx-background-color: #2B59C3; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-min-width: 28; -fx-min-height: 28;" text="1" />
                    <Button mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: #64748B; -fx-background-radius: 6; -fx-min-width: 28; -fx-min-height: 28;" text="2" />
                    <Button mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: #64748B; -fx-background-radius: 6; -fx-min-width: 28; -fx-min-height: 28;" text="3" />
                    <Button mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: #64748B; -fx-background-radius: 6; -fx-min-width: 28; -fx-min-height: 28;" text="4" />
                    <Button mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: #64748B; -fx-background-radius: 6; -fx-min-width: 32; -fx-min-height: 28;" text="•••" />
                    <Button mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: #64748B; -fx-background-radius: 6; -fx-min-width: 28; -fx-min-height: 28;" text="›" />
                </HBox>

            </VBox>
        </VBox>
    </center>
</BorderPane>

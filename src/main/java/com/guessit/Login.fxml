<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.guessit.LoginController"
           prefWidth="1100"
           prefHeight="650"
           stylesheets="@../css/style.css">

    <!-- Background Image -->

    <ImageView fitWidth="1100"
               fitHeight="650"
               preserveRatio="false">

        <image>
            <Image url="@../images/guessit-background.png"/>
        </image>

    </ImageView>


    <!-- Login Form -->

    <VBox alignment="CENTER"
          spacing="22"
          maxWidth="400"
          StackPane.alignment="CENTER_RIGHT"
          styleClass="login-form">

        <padding>
            <Insets top="30" right="60"
                    bottom="30" left="20"/>
        </padding>

        <!-- Title -->

        <VBox alignment="CENTER" spacing="8">

            <Label text="Welcome Back!"
                   styleClass="title"/>

            <Label text="Login to continue"
                   styleClass="subtitle"/>

        </VBox>


        <!-- Username -->

        <TextField fx:id="usernameField"
                   promptText="Enter Username"
                   prefHeight="52"
                   styleClass="input-field"/>


        <!-- Password -->

        <PasswordField fx:id="passwordField"
                       promptText="Enter Password"
                       prefHeight="52"
                       styleClass="input-field"/>


        <!-- Remember Me -->

        <HBox alignment="CENTER_LEFT"
              spacing="10">

            <CheckBox fx:id="rememberCheck"
                      text="Remember Me"
                      styleClass="remember-check"/>

            <Pane HBox.hgrow="ALWAYS"/>

            <Hyperlink text="Forgot Password?"
                       onAction="#forgotPassword"
                       styleClass="link-text"/>

        </HBox>


        <!-- Login Button -->

        <Button text="➜   Login"
                onAction="#handleLogin"
                maxWidth="Infinity"
                prefHeight="55"
                styleClass="login-button"/>


        <!-- Register Link -->

        <HBox alignment="CENTER"
              spacing="5">

            <Label text="Don't have an account?"
                   styleClass="bottom-text"/>

            <Hyperlink text="Register"
                       onAction="#openRegister"
                       styleClass="link-text"/>

        </HBox>

    </VBox>

</StackPane>
.root {
    -fx-background-color: #100707;
}

.welcome-text {
    -fx-text-fill: #E8C47A;
    -fx-font-size: 22px;
    -fx-font-weight: bold;
}

.subtitle {
    -fx-text-fill: white;
    -fx-font-size: 28px;
    -fx-font-weight: bold;
    -fx-effect: dropshadow(
        gaussian,
        rgba(255,180,50,0.8),
        15, 0.5, 0, 0
    );
}

.main-button {
    -fx-background-color: linear-gradient(
        to bottom,
        #D9A441,
        #8B531B
    );

    -fx-text-fill: #1B0B05;
    -fx-font-size: 16px;
    -fx-font-weight: bold;

    -fx-pref-width: 240px;
    -fx-pref-height: 48px;

    -fx-background-radius: 25px;
    -fx-cursor: hand;
}

.main-button:hover {
    -fx-background-color: #F5D58A;

    -fx-effect: dropshadow(
        gaussian,
        #E8B64C,
        20, 0.5, 0, 0
    );

    -fx-scale-x: 1.05;
    -fx-scale-y: 1.05;
}
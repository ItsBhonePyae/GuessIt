<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane prefHeight="860.0" prefWidth="1320.0" styleClass="page"
            stylesheets="@AppTheme.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <HBox alignment="CENTER_RIGHT" spacing="10.0" styleClass="top-strip">
            <children>
                <Region HBox.hgrow="ALWAYS"/>
                <Label styleClass="top-note" text="Signed in as Guest Player"/>
                <Button mnemonicParsing="false" styleClass="icon-btn">
                    <graphic>
                        <SVGPath content="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9 M13.73 21a2 2 0 0 1-3.46 0"
                                 scaleX="0.62" scaleY="0.62" styleClass="icon-stroke"/>
                    </graphic>
                </Button>
                <Button mnemonicParsing="false" styleClass="icon-btn">
                    <graphic>
                        <SVGPath content="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"
                                 scaleX="0.62" scaleY="0.62" styleClass="icon-stroke"/>
                    </graphic>
                </Button>
                <Button mnemonicParsing="false" styleClass="ghost-btn" text="Home"/>
            </children>
        </HBox>
    </top>

    <left>
        <VBox maxWidth="250.0" minWidth="250.0" prefWidth="250.0" spacing="20.0" styleClass="rail">
            <children>
                <VBox spacing="9.0">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <StackPane maxHeight="38.0" maxWidth="38.0" minHeight="38.0"
                                           minWidth="38.0" prefHeight="38.0" prefWidth="38.0"
                                           styleClass="film-badge">
                                    <children>
                                        <SVGPath content="M4.18 2h15.64A2.18 2.18 0 0 1 22 4.18v15.64A2.18 2.18 0 0 1 19.82 22H4.18A2.18 2.18 0 0 1 2 19.82V4.18A2.18 2.18 0 0 1 4.18 2z M7 2v20 M17 2v20 M2 12h20 M2 7h5 M2 17h5 M17 17h5 M17 7h5"
                                                 scaleX="1.42" scaleY="1.42" styleClass="film-badge-icon"/>
                                    </children>
                                </StackPane>
                                <VBox spacing="0.0">
                                    <children>
                                        <Label styleClass="rail-brand" text="GuessIt"/>
                                        <Label styleClass="rail-sub" text="Movie quiz"/>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="7.0">
                            <padding>
                                <Insets left="2.0" top="6.0"/>
                            </padding>
                            <children>
                                <Region maxHeight="7.0" maxWidth="7.0" minHeight="7.0" minWidth="7.0"
                                        prefHeight="7.0" prefWidth="7.0"
                                        style="-fx-background-color: #9d3f3f; -fx-background-radius: 99;"/>
                                <Label styleClass="rail-live" text="Movie mode"/>
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <VBox spacing="5.0">
                    <children>
                        <Button alignment="CENTER_LEFT" contentDisplay="LEFT" graphicTextGap="12.0"
                                maxWidth="Infinity" mnemonicParsing="false" styleClass="nav-item"
                                text="Singleplayer">
                            <graphic>
                                <SVGPath content="M5 3l14 9-14 9V3z" scaleX="0.71" scaleY="0.71"
                                         styleClass="icon-nav-gold"/>
                            </graphic>
                        </Button>
                        <Button alignment="CENTER_LEFT" contentDisplay="LEFT" graphicTextGap="12.0"
                                maxWidth="Infinity" mnemonicParsing="false" styleClass="nav-item-active"
                                text="History">
                            <graphic>
                                <SVGPath content="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z M12 6v6l4 2"
                                         scaleX="0.71" scaleY="0.71" styleClass="icon-nav-gold"/>
                            </graphic>
                        </Button>
                        <Button alignment="CENTER_LEFT" contentDisplay="LEFT" graphicTextGap="12.0"
                                maxWidth="Infinity" mnemonicParsing="false" styleClass="nav-item"
                                text="How to play">
                            <graphic>
                                <SVGPath content="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3 M12 17h.01"
                                         scaleX="0.71" scaleY="0.71" styleClass="icon-nav"/>
                            </graphic>
                        </Button>
                    </children>
                </VBox>

                <Region VBox.vgrow="ALWAYS"/>

                <VBox spacing="4.0" styleClass="promo-card">
                    <children>
                        <Label styleClass="promo-title" text="Round format"/>
                        <Label styleClass="promo-value" text="5 rounds  ·  60 sec"/>
                    </children>
                </VBox>

                <VBox spacing="11.0">
                    <children>
                        <Region maxHeight="1.0" minHeight="1.0" prefHeight="1.0"
                                styleClass="rail-separator"/>
                        <HBox alignment="CENTER_LEFT" spacing="9.0">
                            <children>
                                <StackPane maxHeight="34.0" maxWidth="34.0" minHeight="34.0"
                                           minWidth="34.0" prefHeight="34.0" prefWidth="34.0"
                                           styleClass="avatar">
                                    <children>
                                        <Label styleClass="avatar-text" text="G"/>
                                    </children>
                                </StackPane>
                                <VBox spacing="0.0">
                                    <children>
                                        <Label styleClass="profile-name" text="Guest Player"/>
                                        <Label styleClass="profile-meta" text="GuessIt player"/>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                        <Label styleClass="rail-logout" text="Log out"/>
                    </children>
                </VBox>
            </children>
        </VBox>
    </left>

    <center>
        <VBox spacing="16.0" style="-fx-background-color: #0b0e12;">
            <padding>
                <Insets bottom="30.0" left="44.0" right="44.0" top="34.0"/>
            </padding>
            <children>
                <Label styleClass="page-eyebrow" text="RECENT ROUNDS"/>
                <Label styleClass="page-heading" text="History"/>
                <Label maxWidth="620.0" styleClass="page-copy" wrapText="true"
                       text="Example entries are shown here; each round you play is added to this list."/>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Button mnemonicParsing="false" styleClass="play-btn" text="All rounds"/>
                        <Button mnemonicParsing="false" styleClass="ghost-btn" text="Wins"/>
                        <Button mnemonicParsing="false" styleClass="ghost-btn" text="Losses"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label styleClass="count" text="5 / 5 rounds"/>
                    </children>
                </HBox>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="menu-scroll"
                            VBox.vgrow="ALWAYS">
                    <content>
                        <VBox spacing="8.0">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="13.0" styleClass="history-row">
                                    <children>
                                        <StackPane maxHeight="38.0" maxWidth="38.0" minHeight="38.0"
                                                   minWidth="38.0" prefHeight="38.0" prefWidth="38.0"
                                                   styleClass="history-badge">
                                            <children>
                                                <Label styleClass="history-badge-text" text="AB"/>
                                            </children>
                                        </StackPane>
                                        <VBox spacing="3.0">
                                            <children>
                                                <Label styleClass="history-title" text="Above the Below"/>
                                                <Label styleClass="history-meta"
                                                       text="Played this session  ·  Nov 23, 6:12 PM"/>
                                            </children>
                                        </VBox>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label styleClass="history-score" text="4,250"/>
                                        <Label styleClass="win" text="WIN"/>
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="13.0" styleClass="history-row">
                                    <children>
                                        <StackPane maxHeight="38.0" maxWidth="38.0" minHeight="38.0"
                                                   minWidth="38.0" prefHeight="38.0" prefWidth="38.0"
                                                   styleClass="history-badge">
                                            <children>
                                                <Label styleClass="history-badge-text" text="DU"/>
                                            </children>
                                        </StackPane>
                                        <VBox spacing="3.0">
                                            <children>
                                                <Label styleClass="history-title" text="Dune: Part Three"/>
                                                <Label styleClass="history-meta"
                                                       text="Example round  ·  Nov 23, 5:48 PM"/>
                                            </children>
                                        </VBox>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label styleClass="history-score" text="3,500"/>
                                        <Label styleClass="win" text="WIN"/>
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="13.0" styleClass="history-row">
                                    <children>
                                        <StackPane maxHeight="38.0" maxWidth="38.0" minHeight="38.0"
                                                   minWidth="38.0" prefHeight="38.0" prefWidth="38.0"
                                                   styleClass="history-badge">
                                            <children>
                                                <Label styleClass="history-badge-text" text="MO"/>
                                            </children>
                                        </StackPane>
                                        <VBox spacing="3.0">
                                            <children>
                                                <Label styleClass="history-title" text="Moana"/>
                                                <Label styleClass="history-meta"
                                                       text="Example round  ·  Nov 23, 5:31 PM"/>
                                            </children>
                                        </VBox>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label styleClass="history-score" text="0"/>
                                        <Label styleClass="loss" text="LOSS"/>
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="13.0" styleClass="history-row">
                                    <children>
                                        <StackPane maxHeight="38.0" maxWidth="38.0" minHeight="38.0"
                                                   minWidth="38.0" prefHeight="38.0" prefWidth="38.0"
                                                   styleClass="history-badge">
                                            <children>
                                                <Label styleClass="history-badge-text" text="ST"/>
                                            </children>
                                        </StackPane>
                                        <VBox spacing="3.0">
                                            <children>
                                                <Label styleClass="history-title" text="Star Wars"/>
                                                <Label styleClass="history-meta"
                                                       text="Example round  ·  Nov 23, 4:59 PM"/>
                                            </children>
                                        </VBox>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label styleClass="history-score" text="5,000"/>
                                        <Label styleClass="win" text="WIN"/>
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="13.0" styleClass="history-row">
                                    <children>
                                        <StackPane maxHeight="38.0" maxWidth="38.0" minHeight="38.0"
                                                   minWidth="38.0" prefHeight="38.0" prefWidth="38.0"
                                                   styleClass="history-badge">
                                            <children>
                                                <Label styleClass="history-badge-text" text="HE"/>
                                            </children>
                                        </StackPane>
                                        <VBox spacing="3.0">
                                            <children>
                                                <Label styleClass="history-title" text="Hexed"/>
                                                <Label styleClass="history-meta"
                                                       text="Example round  ·  Nov 23, 4:22 PM"/>
                                            </children>
                                        </VBox>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label styleClass="history-score" text="0"/>
                                        <Label styleClass="loss" text="LOSS"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </content>
                </ScrollPane>
            </children>
        </VBox>
    </center>
</BorderPane>
